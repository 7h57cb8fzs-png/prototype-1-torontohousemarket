{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prototype-1-torontohousemarket",
  "compatibility_date": "2026-08-14",
  "main": "worker-v10.js",
  "secrets": {
    "required": ["AMPRE_TOKEN"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
