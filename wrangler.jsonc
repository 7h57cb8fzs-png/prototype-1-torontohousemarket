{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prototype-1-torontohousemarket",
  "compatibility_date": "2026-08-25",
  "preview_urls": true,
  "vars": { "PUBLIC_DISCOVERY_ENABLED": "true" },
  "main": "worker-v13.js",
  "ai": { "binding": "AI" },
  "secrets": {
    "required": ["AMPRE_TOKEN", "AMPRE_VOW_TOKEN", "SUPABASE_SERVICE_ROLE_KEY", "ADMIN_API_KEY", "RESEND_API_KEY", "OPENAI_API_KEY"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/seller.js"]
  }
}
